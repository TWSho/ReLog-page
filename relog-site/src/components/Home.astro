---
import Layout from '../layouts/Layout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { copy, type Locale } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---
<Layout locale={locale}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="tiny-star" aria-hidden="true">✳︎</span>{t.eyebrow}</p>
      <h1 id="hero-title">{t.hero.map((line, i) => <span class:list={{ 'accent-text': i === 1 }}>{line}</span>)}</h1>
      <p class="hero-intro">{t.intro}</p>
      <div class="hero-actions"><a class="button primary" href="#availability">{t.cta}<span aria-hidden="true">↗</span></a><a class="text-link" href="#about">{t.discover}<span aria-hidden="true">↓</span></a></div>
      <p class="platform"><svg width="14" height="17" viewBox="0 0 14 17" aria-hidden="true"><rect x="3" y="1" width="8" height="14" rx="2" fill="none" stroke="currentColor"/><path d="M6 13h2" stroke="currentColor"/></svg>{t.platform}</p>
    </div>
    <div class="brand-panel">
      <img src={`${import.meta.env.BASE_URL}icon_nobg.png`} width="1024" height="1024" alt="ReLog" fetchpriority="high" />
      <p class="brand-name" aria-hidden="true">ReLog</p>
      <p class="brand-tagline">{t.tagline}</p>
    </div>
  </section>

  <div class="relationship-strip container"><span class="strip-label">EVERY KIND OF CONNECTION</span><ul>{t.types.map((type, i) => <li><span class={`type-dot tone-${i}`} aria-hidden="true"></span>{type}</li>)}</ul></div>

  <section class="philosophy container section" id="about" aria-labelledby="about-title">
    <p class="eyebrow">{t.philosophyLabel}</p>
    <div class="philosophy-grid"><h2 id="about-title">{t.philosophy.map((line) => <span>{line}</span>)}</h2><p>{t.philosophyText}</p></div>
  </section>

  <section class="features container section" id="features" aria-labelledby="features-title">
    <div class="section-heading"><div><p class="eyebrow">{t.featuresLabel}</p><h2 id="features-title">{t.featuresTitle}</h2></div><span class="heading-flower" aria-hidden="true">✳︎</span></div>
    <div class="feature-grid">
      {t.features.map((feature) => <article class="feature-card"><p class="card-label"><span>{feature.number}</span>{feature.tag}</p><h3>{feature.title}</h3><p class="feature-description">{feature.text}</p></article>)}
    </div>
  </section>

  <section class="care-section" aria-labelledby="care-title"><div class="container care-inner"><div><p class="eyebrow">{t.careLabel}</p><h2 id="care-title">{t.careTitle.map((line) => <span>{line}</span>)}</h2></div><div><p class="care-text">{t.careText}</p><a class="text-link" href={getRelativeLocaleUrl(locale, 'privacy')}>{t.careLink}<span aria-hidden="true">↗</span></a></div></div></section>

  <section class="faq container section" id="faq" aria-labelledby="faq-title"><div><p class="eyebrow">{t.faqLabel}</p><h2 id="faq-title">{t.faqTitle}</h2><p class="faq-footnote">A little clarity,<br />a little peace of mind.</p></div><div class="faq-list">{t.faq.map((item, index) => <details name="faq"><summary><span class="question-number">0{index + 1}</span><span>{item.q}</span><span class="disclosure-icon" aria-hidden="true"></span></summary><p>{item.a}</p></details>)}</div></section>

  <section class="availability container" id="availability" aria-labelledby="availability-title"><span class="closing-doodle" aria-hidden="true">✳︎</span><p class="eyebrow">{t.availabilityLabel}</p><h2 id="availability-title">{t.availabilityTitle.map((line) => <span>{line}</span>)}</h2><p>{t.availabilityText}</p><span class="release-status"><span class="live-dot" aria-hidden="true"></span>{t.status}</span></section>
</Layout>